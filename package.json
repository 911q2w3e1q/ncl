{
  "name": "ncl",
  "productName": "Nexus Craft Launcher",
  "version": "1.11.2",
  "description": "NCL — Nexus Craft Launcher，一个功能完整的 Minecraft Java 版启动器：离线/LittleSkin 账户、版本管理、四大模组加载器、自动下载 Java 与依赖库、AI 报错分析、一键启动",
  "main": "main/main.js",
  "license": "MIT",
  "author": "",
  "scripts": {
    "start": "electron .",
    "setup:electron": "node tools/setup-electron.js",
    "build:ai-runtime": "esbuild build/ai-runtime-entry.js --bundle --format=esm --platform=browser --outfile=ai/ai-runtime.js --alias:onnxruntime-web/webgpu=./node_modules/onnxruntime-web/dist/ort.bundle.min.mjs --define:process.env.NODE_ENV=\"production\"",
    "test": "node test/core-test.js",
    "test:install": "node test/install-test.js",
    "test:launch": "node test/launch-test.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/get": "^5.1.0",
    "@huggingface/transformers": "^4.3.1",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2"
  }
}
